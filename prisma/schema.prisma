generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ── enums and models unchanged from before ──

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

// One role for Wave A.
//
// The roadmap (Stage 6) allows exactly this: "Initially, you may only need
// ADMIN, CUSTOMER — but the architecture should not make staff roles
// difficult later." Crownline launches with a single operator, so splitting
// authority between MANAGER and STAFF would have been governance theatre:
// separation of duties only means something when there are two people to
// separate.
//
// Nothing about re-introducing them is hard. The permission matrix in
// src/lib/auth/permissions.ts still maps role -> permissions, every page and
// action still asks `can(role, permission)`, and adding a value here is an
// additive `ALTER TYPE ... ADD VALUE` in Postgres. What would have been
// expensive is removing that layer entirely and hard-coding "is an admin"
// across forty call sites — so the layer stays, holding one role.
enum AdminRole {
  ADMIN
}

/// The state of a *listing*, not of a car in transit.
///
/// The brief's Stage 8 sketch listed "In Transit" and "Delivered" alongside
/// these. They are deliberately absent, and the distinction is load-bearing:
///
///   VehicleStatus  — may a customer see this listing, and can it still be
///                    bought? Owned by the inventory, changed by
///                    `updateVehicleStatusAction` through
///                    ALLOWED_VEHICLE_TRANSITIONS.
///   TrackingStatus — where the physical car has got to on its way to Juba.
///                    Owned by Shipment/TrackingEvent, changed by
///                    `updateTrackingStatus`, and shown to the customer who
///                    bought it.
///
/// Adding IN_TRANSIT here would create a second place that answers "where is
/// the car", reachable by an operator editing a dropdown on the listing
/// screen rather than by recording a tracking event — so the two would drift,
/// and the marketplace card and the customer's tracking page would disagree
/// about the same vehicle. It would also blur the one question this column
/// exists to answer: a car that is shipping has been SOLD, and SOLD is
/// already how the listing says so.
///
/// One vehicle can also carry more than one shipment over its life (a
/// re-export, a Wave B order containing parts as well), which a single
/// column on Vehicle cannot represent at all.
enum VehicleStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  ARCHIVED
}

// Whether the vehicle has had a previous owner.
//
// Two values, and deliberately only two. An importer's stock is either a
// brand-new unit or a used import, and the grades in between ("nearly new",
// "ex-demo") are judgements a buyer reads out of the mileage, the year and
// the description rather than out of a badge. A third value would be an
// opinion presented as a fact on a listing that is also a price quotation.
//
// USED is the default in the database because it is the honest one: a
// listing that has not been told otherwise is not a new car, and a wrong
// NEW on a public page is a misrepresentation, not a cosmetic slip.
enum VehicleCondition {
  NEW
  USED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
  CVT
}

enum DriveType {
  FWD
  RWD
  AWD
  FOUR_WD
}

enum CountryOfOrigin {
  JAPAN
  KOREA
}

enum QuoteType {
  VEHICLE
  // Wave B appends: SPARE_PART
}

enum QuoteStatus {
  NEW
  CONTACTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PreferredCountry {
  JAPAN
  KOREA
  EITHER
}

enum OrderStatus {
  PENDING_DEPOSIT
  DEPOSIT_CONFIRMED
  PROCESSING
  AWAITING_FINAL_PAYMENT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  MANUAL_OTHER
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  UNDER_VERIFICATION
  CONFIRMED
  REJECTED
  REFUNDED
  FAILED
}

enum ShipmentType {
  VEHICLE
  // Wave B appends: SPARE_PART
}

enum TrackingStatus {
  // Wave A — vehicle logistics
  PURCHASED
  INSPECTION_COMPLETED
  EXPORT_DOCUMENTATION
  EXPORTED
  LOADED_FOR_SHIPPING
  IN_TRANSIT
  ARRIVED_AT_MOMBASA
  CLEARING
  TRANSPORT_TO_SOUTH_SUDAN
  READY_FOR_COLLECTION
  DELIVERED
  // Wave B appends: ORDER_CONFIRMED, PROCESSING, PACKED, DISPATCHED, OUT_FOR_DELIVERY
  // (IN_TRANSIT and DELIVERED are intentionally shared across both product types)
}

enum MilestoneStatus {
  PENDING // not yet activated
  DUE // currently the active/owed milestone
  PARTIALLY_PAID
  PAID
}

// ─────────────────────────────────────────────
// ADMIN / AUDIT
// ─────────────────────────────────────────────

model AdminProfile {
  id          String    @id // Supabase auth.users UID — no @default, set explicitly on first login
  email       String    @unique
  displayName String
  role        AdminRole @default(ADMIN)
  isActive    Boolean   @default(true)

  verifiedPayments      Payment[]
  trackingEventsCreated TrackingEvent[] @relation("TrackingEventCreatedBy")
  trackingEventsVoided  TrackingEvent[] @relation("TrackingEventVoidedBy")
  auditLogs             AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model AuditLog {
  id      String       @id @default(cuid())
  actorId String
  actor   AdminProfile @relation(fields: [actorId], references: [id], onDelete: Restrict)

  action     String // e.g. "PAYMENT_CONFIRMED", "VEHICLE_PUBLISHED", "TRACKING_STATUS_UPDATED"
  entityType String // e.g. "Payment" | "Vehicle" | "Order" | "Shipment"
  entityId   String
  metadata   Json? // e.g. { previousStatus, newStatus }

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Atomic counter backing all CLM-style reference numbers.
// One row per (sequence type + year), e.g. "VEHICLE-2026", "ORDER-2026".
// Incremented via a single atomic UPDATE ... SET lastValue = lastValue + 1 RETURNING lastValue —
// Postgres guarantees this is race-safe without needing SELECT ... FOR UPDATE.
model ReferenceSequence {
  id          Int    @id @default(autoincrement())
  sequenceKey String @unique
  lastValue   Int    @default(0)
}

// ─────────────────────────────────────────────
// VEHICLE
// ─────────────────────────────────────────────

model Vehicle {
  id              String @id @default(cuid())
  referenceNumber String @unique // CLM-V-2026-000123
  slug            String @unique

  make            String
  model           String
  year            Int
  price           Decimal          @db.Decimal(12, 2)
  mileageKm       Int
  fuelType        FuelType
  transmission    TransmissionType
  engineSize      String
  driveType       DriveType
  exteriorColor   String
  interiorColor   String
  countryOfOrigin CountryOfOrigin
  currentLocation String
  condition       VehicleCondition @default(USED)

  // Live estimates shown on the public listing — NOT the same as the
  // figures locked into Order once a quote is accepted (see Order below).
  shippingEstimate Decimal? @db.Decimal(12, 2)
  clearingEstimate Decimal? @db.Decimal(12, 2)
  otherChargesEst  Decimal? @db.Decimal(12, 2)

  description String        @db.Text
  status      VehicleStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)

  // The equipment list a buyer scans before enquiring — "Sunroof", "Reverse
  // camera", "Leather seats" — one entry per line as the operator typed
  // them, in that order.
  //
  // ── Why a scalar list and not a VehicleFeature table ────────────────
  // A feature here has no identity of its own: nothing references one, no
  // query selects by one, and none of them outlive the vehicle they were
  // typed against. A join table would buy referential integrity over data
  // that has no referents, at the cost of a second write path, a second
  // ordering column, and a join on every read of a listing.
  //
  // The one thing it would eventually buy is filtering ("show me cars with
  // a sunroof"), which the brief does not ask for and which free text
  // cannot answer honestly anyway — "Sun roof" and "Sunroof" are the same
  // feature and different strings. When that becomes a requirement it wants
  // a curated vocabulary, not this column promoted; a Postgres text[] can
  // be GIN-indexed in the meantime if a contains-search is ever needed.
  features String[] @default([])

  photos     VehiclePhoto[]
  quotes     Quote[]
  orderItems OrderItem[]
  shipments  Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isFeatured])
  @@index([make, model])
  @@index([year])
  @@index([price])
  // Trigram indexes backing the admin list's search box.
  //
  // That search is `contains` + `mode: "insensitive"`, which Prisma compiles
  // to ILIKE '%term%'. A leading wildcard makes a B-tree index useless — the
  // planner has no prefix to seek on — so the three columns below were being
  // sequentially scanned on every keystroke of a debounced search.
  //
  // A GIN index over trigrams is the standard answer: it indexes every
  // three-character substring, so an infix match becomes an index lookup.
  // The cost is a slightly slower write per vehicle, which is irrelevant on a
  // table an operator appends to a few times a day.
  //
  // Modelled here rather than only in raw SQL so `prisma migrate` knows they
  // exist. An index created by a migration but absent from this schema is one
  // Prisma proposes to DROP the next time a migration is generated.
  @@index([make(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([model(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([referenceNumber(ops: raw("gin_trgm_ops"))], type: Gin)
}

model VehiclePhoto {
  id          String  @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  storagePath String
  // Reserved for the public gallery and SEO work (Stages 11 / 34). Not
  // written by the dashboard: an operator arranging a walk-around should not
  // be asked to write alt text for every frame, so the gallery generates a
  // truthful description from the vehicle and the photo's position instead.
  altText     String?

  // A vehicle with at least one live photograph has exactly one primary —
  // the image customers see on the card and at the top of the gallery.
  // Maintained at write time by reconcilePrimary(), never derived on read.
  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)

  deletedAt DateTime? // soft delete — admin "delete photo" sets this, never a hard delete

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────────

model Customer {
  id       String  @id @default(cuid())
  fullName String
  phone    String // NOT unique — dedupe manually in server actions, see notes above
  whatsapp String?
  email    String? @unique
  country  String?
  city     String?

  deletedAt DateTime? // soft delete / anonymization — row persists, PII scrubbed on delete

  quotes Quote[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────
// QUOTE
// ─────────────────────────────────────────────

model Quote {
  id          String @id @default(cuid())
  quoteNumber String @unique // CLM-Q-2026-000045

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  type QuoteType @default(VEHICLE)

  // Populated when the quote originated from "REQUEST THIS VEHICLE" on a listing;
  // null for a blank "GET A QUOTE" enquiry. SetNull on delete — a quote is a soft
  // enquiry and should survive even if the referenced listing is later removed.
  linkedVehicleId String?
  linkedVehicle   Vehicle? @relation(fields: [linkedVehicleId], references: [id], onDelete: SetNull)

  requestedMake          String?
  requestedModel         String?
  preferredYear          Int?
  maxBudget              Decimal?          @db.Decimal(12, 2)
  preferredCountry       PreferredCountry?
  fuelType               FuelType?
  transmission           TransmissionType?
  additionalRequirements String?           @db.Text

  status     QuoteStatus @default(NEW)
  adminNotes String?     @db.Text

  order Order? // set only once this quote is accepted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ORDER
// ─────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // CLM-O-2026-000012

  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  // Denormalized from quote.customerId on purpose: lets the customer dashboard
  // (Wave B) and admin order list query orders-by-customer directly without a
  // join through Quote every time. Set once at creation, never changes.
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  status OrderStatus @default(PENDING_DEPOSIT)

  // Locked in at the moment the quote is accepted — deliberately independent
  // of Vehicle's live *estimate* fields, so a price change on the listing
  // never silently changes what a customer already committed to.
  shippingCost          Decimal?           @db.Decimal(12, 2)
  clearingCost          Decimal?           @db.Decimal(12, 2)
  otherCharges          Decimal?           @db.Decimal(12, 2)
  totalAmount           Decimal            @db.Decimal(12, 2)
  requiredDepositAmount Decimal?           @db.Decimal(12, 2)
  milestones            PaymentMilestone[]

  notes String? @db.Text

  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  // sparePartId String?  <- Wave B adds this as a sibling nullable FK, same pattern.
  // In Wave A, vehicleId is required in practice — enforced via Zod, not the DB,
  // since the column must stay nullable for Wave B.

  description String // snapshot at order time, e.g. "2021 Toyota Harrier — CLM-V-2026-000123"
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int     @default(1)
  lineTotal   Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([vehicleId])
}

// ─────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  amount               Decimal       @db.Decimal(12, 2)
  method               PaymentMethod
  transactionReference String?
  paymentDate          DateTime?
  receiptStoragePath   String?

  status      PaymentStatus     @default(PENDING)
  milestoneId String?
  milestone   PaymentMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  verifiedByAdminId String?
  verifiedByAdmin   AdminProfile? @relation(fields: [verifiedByAdminId], references: [id], onDelete: Restrict)
  verifiedAt        DateTime?
  adminNotes        String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([paymentDate])
  @@index([milestoneId])
}

// ─────────────────────────────────────────────
// SHIPMENT / TRACKING
// ─────────────────────────────────────────────

model Shipment {
  id             String @id @default(cuid())
  trackingNumber String @unique // CLM-2026-000125 — what the customer types into Track My Order

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // A shipment is a physical consignment, not a line item — one shipment can
  // eventually cover multiple order items (e.g. a Wave B parts order shipped
  // in one box). vehicleId disambiguates which vehicle this shipment concerns
  // for Wave A, where the mapping is always 1:1.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  // sparePartOrderId String? <- Wave B extension point

  shipmentType    ShipmentType   @default(VEHICLE)
  currentStatus   TrackingStatus @default(PURCHASED)
  currentLocation String?

  events TrackingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([currentStatus])
}

model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status   TrackingStatus
  location String?
  notes    String?        @db.Text

  // Business-meaningful date — editable by admin, can be backdated for
  // offline events. Independent from createdAt (system-truth insert time).
  eventDate DateTime @default(now())

  createdByAdminId String
  createdByAdmin   AdminProfile @relation("TrackingEventCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  // Void mechanism instead of delete: an erroneous entry is corrected by
  // voiding it (with a reason) and inserting a new correct event — the
  // audit trail is never destroyed, only annotated.
  isVoided        Boolean       @default(false)
  voidedAt        DateTime?
  voidedByAdminId String?
  voidedByAdmin   AdminProfile? @relation("TrackingEventVoidedBy", fields: [voidedByAdminId], references: [id], onDelete: Restrict)
  voidReason      String?

  createdAt DateTime @default(now())

  @@index([shipmentId, eventDate])
  @@index([isVoided])
}

model BusinessSettings {
  id                       Int      @id @default(1) // always exactly one row, id=1 — enforced by app logic, not a DB constraint
  whatsappNumber           String
  defaultInitialPercentage Decimal  @default(50.00) @db.Decimal(5, 2)
  defaultMombasaPercentage Decimal  @default(25.00) @db.Decimal(5, 2)
  defaultFinalPercentage   Decimal  @default(25.00) @db.Decimal(5, 2)
  updatedAt                DateTime @updatedAt
}

model PaymentMilestone {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sequence   Int // 1, 2, 3 — processing/display order
  label      String // e.g. "Initial Payment (50%)", "Mombasa Payment (25%)", "Final Payment (25%)"
  percentage Decimal @db.Decimal(5, 2) // locked in from BusinessSettings at order-creation time
  amountDue  Decimal @db.Decimal(12, 2) // locked in = percentage% of Order.totalAmount at creation time

  status        MilestoneStatus @default(PENDING)
  triggerStatus TrackingStatus? // e.g. ARRIVED_AT_MOMBASA — informs automation, doesn't enforce it
  becameDueAt   DateTime?
  completedAt   DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, sequence])
  @@index([orderId])
  @@index([status])
}

// ─────────────────────────────────────────────
// RATE LIMITING
// ─────────────────────────────────────────────

/// One recorded attempt at a rate-limited action. Currently only admin
/// sign-in.
///
/// ── Why this is a table and not an in-memory counter ──────────────────
/// The application runs on Vercel, where each request may be served by a
/// different serverless instance and instances are recycled constantly. A
/// Map in module scope would therefore count a fraction of the attempts, and
/// an attacker would get seven tries *per instance* — a limit that looks
/// present in code review and is absent in production. Postgres is the only
/// state every instance already shares, so it is where the counter belongs.
///
/// Redis (Upstash) is the conventional home for this and is explicitly a
/// Phase 2 item in the roadmap. Nothing here blocks that move: the limiter in
/// src/lib/auth/rate-limit.ts is the only module that reads or writes this
/// table, so swapping its storage is a change to one file. The volume this
/// carries — a handful of rows per failed sign-in on a single-dealership
/// admin panel — does not justify the infrastructure yet.
///
/// ── Why a log of attempts rather than a counter row ───────────────────
/// A counter needs a window start, and a fixed window lets an attacker fire
/// the full budget at the end of one window and again at the start of the
/// next: fourteen attempts in seconds while never technically exceeding
/// seven per window. Counting rows inside a rolling window has no such seam,
/// and at this volume the extra rows are free. Expired rows are pruned by
/// the limiter itself.
model LoginAttempt {
  id String @id @default(cuid())

  /// What is being limited, hashed — never the email address or IP itself.
  ///
  /// This table exists to *reject* traffic, so it accumulates rows for
  /// people who mistyped a password and for whoever is attacking them. In
  /// plain text it would become a durable list of staff email addresses
  /// beside the IPs they sign in from: a small privacy problem in normal
  /// operation, and a ready-made target list if the database is ever
  /// exposed. A SHA-256 of "<scope>:<identifier>" answers the only question
  /// the limiter asks — "how many attempts share this key?" — without
  /// storing anything worth stealing (SECURITY.MD §38).
  identifierHash String

  /// Which bucket this belongs to, e.g. "admin-login:email" /
  /// "admin-login:ip". Kept in the clear because it names a category, not a
  /// person, and a limiter that cannot tell its buckets apart cannot expire
  /// one without the other.
  scope String

  createdAt DateTime @default(now())

  /// The limiter's only query: count rows for one key newer than a cutoff.
  /// Ordered to match — equality columns first, range column last — so the
  /// window scan is an index range rather than a filter over the bucket.
  @@index([scope, identifierHash, createdAt])
  /// Supports the housekeeping delete that drops rows past every window.
  @@index([createdAt])
}
